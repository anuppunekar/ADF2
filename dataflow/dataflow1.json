{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "InputBlobStorageDataCsv",
						"type": "DatasetReference"
					},
					"name": "ProductsSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureDataLakeStorage",
						"type": "DatasetReference"
					},
					"name": "ProductsSink"
				}
			],
			"transformations": [
				{
					"name": "DeriveCategory"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ProductID as string,",
				"          ProductName as string,",
				"          Category as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ProductsSource",
				"ProductsSource derive(CategoryCode = iif(Category == 'Mountain Bikes', '01',\r",
				"iif(Category == 'Road Bikes', '02',\r",
				"iif(Category == 'Touring Bikes', '03', '00')))) ~> DeriveCategory",
				"DeriveCategory sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ProductID as string,",
				"          ProductName as string,",
				"          Category as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ProductsSink"
			]
		}
	}
}